//****************************************************************************
// $Module type: Program
// $Module name: RDCFlexTronDemo
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-23
//
// Description : The RDCFlexTron library at work in a Windows program: ONE themed FlexTron host laid out
//               as a grid (cDemoGridHost, a prototype) holding a page built with the markup builders and
//               icons, cFTWebButton objects - real web buttons the Studio's Designer draws - and an Exit
//               button; a modal panel with a Close button of its own (DemoDialog.dg); and the Dark /
//               Light / Follow Windows choice.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use DFAllEnt.pkg
Use FTConstants.h.pkg               // the CI_FTTheme* modes, and where the theme choice is saved

// The name of a theme mode, for the page and for SwitchTheme's message.
Function DemoThemeName Global Integer iMode Returns String
    If (iMode = CI_FTThemeLight) ;
        Function_Return "Light"
    If (iMode = CI_FTThemeSystem) ;
        Function_Return "Follow Windows"
    Function_Return "Dark"
End_Function

Object oApplication is a cApplication
    Set psCompany to "RDC Tools International"
    Set psProduct to "RDCFlexTron Demo"
    Set psVersion to "26.0"
    Set peHelpType to htNoHelp

    // The theme is read once, when the program starts: a new choice starts a new copy of this program
    // and ends this one.
    Procedure RestartDemo
        String sExe sCommand
        Get GetApplicationFileName to sExe
        Move ('"' + sExe + '"') to sCommand
        Runprogram Background sCommand
        Send Exit_Application
    End_Procedure

    // A theme button's click (cDemoThemeButton): save the choice, and start again in it.
    Procedure SwitchTheme Integer iMode
        Send WriteInteger CS_FTThemeSection CS_FTTheme iMode
        Send Info_Box ((DemoThemeName(iMode)) + " is saved. The demo restarts when you close this message.") "Theme"
        Send RestartDemo
    End_Procedure
End_Object

// The theme is read from the saved choice (Settings\FTTheme under this program's registry key) as
// soon as the application object exists - and before any panel colours itself while it is
// constructed, which every panel below does.
Use FTThemeSeed.pkg
Send SeedFTTheme

Use cFTPanel.pkg                    // the main window: a Panel with the FT ground colour
Use cFTLocalWebControlHost.pkg      // a web control needs a host Used before it
Use cDemoGridHost.pkg               // PROTOTYPE: the host as a grid of 8 px columns, laid out like a Windows dialog
Use FTAllWebControlClasses.pkg      // cFTWebButton, cFTWebLabel, cFTWebHtmlBox and the rest of the family
Use cDemoButton.pkg                 // PROTOTYPE: a cFTWebButton taking 10 of those columns
Use cFTHtmlPage.pkg                 // a whole page, with the picture beside its title (psTitleIcon)
Use FTMarkupBuilders.pkg            // DivOpen, TagHtml, CssLink ...
Use FTDashIcons.pkg                 // DashIcon and its CS_Glyph* names
Use DemoConstants.h.pkg             // CS_DemoSheets - the library's style sheet links
Use DemoDialog.dg                   // oDemoDialog - the modal panel that "Open the dialog" opens

// ---------------------------------------------------------------------------------------------------
// The pages - global functions, so they are defined before the objects that call them.
// ---------------------------------------------------------------------------------------------------

// The main window's page: the library in a few lines, built with the builders it describes.
// sTitleIcon is the page's TitleIconHtml.
Function DemoPageHtml Global String sTitleIcon Returns String
    String s sItems
    Move (CS_DemoSheets + (CssLink("demo"))) to s
    Move (s + (DivOpen("demo"))) to s
    Move (s + (TagHtml("h1", "", (sTitleIcon + "RDCFlexTron")))) to s
    Move (s + (TagText("p", "", "Themed FlexTron hosts, web controls and modal panels for DataFlex Windows programs, with HTML builders and inline icons."))) to s
    Move (s + (TagText("h2", "", "On this window"))) to s
    Move (BulletItem("The whole window is ONE host, a " + (CodeText("cDemoGridHost")) + ": a grid of 8 px columns and three rows - the buttons, this page and Exit. A control takes a row with " + (CodeText("piRowIndex")) + ", and this page fills its row with " + (CodeText("pbFillHeight")) + ".")) to sItems
    Move (sItems + (BulletItem("This page is a " + (CodeText("cFTHtmlPage")) + ", built with " + (CodeText("FTMarkupBuilders")) + "."))) to sItems
    Move (sItems + (BulletItem("The mark beside the title is the page's " + (CodeText("psTitleIcon")) + ": an image file here, a " + (CodeText("DashIcon")) + " glyph in the dialog."))) to sItems
    Move (sItems + (BulletItem("The buttons above are " + (CodeText("cFTWebButton")) + " objects: real web buttons, so the Studio's Designer draws them. A glyph is a class in " + (CodeText("psCSSClass")) + " - " + (CodeText("ftg-exit")) + " and the like, from ftglyphs.css - so the Designer draws it too. The font is " + (CodeText("psFontFamily")) + ", " + (CodeText("piFontSize")) + " and " + (CodeText("pbBold")) + "."))) to sItems
    Move (sItems + (BulletItem("Each column is 8 px, so a button's span is its width in 8 px steps: 10 unless it says otherwise - Follow Windows takes 15, Open the dialog 18. One empty column takes the extra width and this page's row the extra height, so the buttons keep their size and the right-hand ones stay at the edge - like anchors in a Windows dialog."))) to sItems
    Move (sItems + (BulletItem("A click's work is the button's " + (CodeText("OnButtonClick")) + ", which runs after the web click has returned - so it can open a dialog, or restart the program."))) to sItems
    Move (s + (BulletList(sItems))) to s
    Move (s + (TagText("h2", "", "Theme"))) to s
    Move (s + (TagText("p", "", ("In use: " + (DemoThemeName(giFTThemeMode)) + ". A new choice is saved, and the demo restarts in it.")))) to s
    Move (s + "</div>") to s
    Function_Return s
End_Function

// ---------------------------------------------------------------------------------------------------
// The buttons
// ---------------------------------------------------------------------------------------------------

/* A theme button: a cDemoButton that knows which theme it stands for. The theme in use is shown
   disabled - choosing it again would change nothing. The click goes to the application object's
   SwitchTheme. */
Class cDemoThemeButton is a cDemoButton
    Procedure Construct_Object
        Forward Send Construct_Object
        { Category="Behavior" }
        Property Integer piThemeMode CI_FTThemeDark
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object
        If (piThemeMode(Self) = giFTThemeMode) Begin
            Set pbEnabled to False
            Set psToolTip to "The theme in use"
        End
        Else ;
            Set psToolTip to ("Switch to " + psCaption(Self) + " and restart the demo")
    End_Procedure

    Procedure OnButtonClick
        Send SwitchTheme of ghoApplication (piThemeMode(Self))
    End_Procedure
End_Class

// ---------------------------------------------------------------------------------------------------
// The main window
// ---------------------------------------------------------------------------------------------------

/* The main window: ONE host, laid out like a Windows dialog on a grid of 8 px columns and three rows -
   the buttons at the top, the page in the middle taking the extra height, Exit at the bottom right. The
   grid does the layout, in the browser, on every resize; cFTPanel fits the host itself to the window's
   client area (phoClientHost). */
Object oMain is a cFTPanel
    Set Label to "RDCFlexTron Demo"
    Set Location to 190 119
    Set Size to 300 440
    Set piMinSize to 180 360  

    /* THE HOST: every control of the window, on one grid (cDemoGridHost). Each is an object of its own,
       so the Studio's Designer draws it where it sits. */
    Object oHost is a cDemoGridHost
        Set Location to 4 4
        Set Size to 275 432
        Set peAnchors to anNone         // placed by cFTPanel (phoClientHost)
        // 62 columns: 61 of 8 px (488 px) and column 43, which takes the extra width. The window's minimum
        // width (360 units, about 516 px for the host at 1.5 px a unit) still holds them.
        Set piColumnCount to 62
        Set psColumnWidths to "43/1fr"  // column 43 - empty - takes the extra width
        Set psRowHeights to "1/1fr"     // row 1, the page, takes the extra height

        // Row 0: the theme choice on the left, the dialog button at the right edge.
        Object oThemeLabel is a cFTWebLabel
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan to 8
            Set psCaption to "Theme"
            Set psCSSClass to "FtCompact ftaccent"      // ftaccent: the amber caption (ftcontrols.css)
        End_Object

        Object oDarkBtn is a cDemoThemeButton
            Set piRowIndex to 0
            Set piColumnIndex to 8
            Set psCaption to "Dark"
            Set piThemeMode to CI_FTThemeDark
        End_Object

        Object oLightBtn is a cDemoThemeButton
            Set piRowIndex to 0
            Set piColumnIndex to 18
            Set psCaption to "Light"
            Set piThemeMode to CI_FTThemeLight
        End_Object

        Object oSystemBtn is a cDemoThemeButton
            Set piRowIndex to 0
            Set piColumnIndex to 28
            Set piColumnSpan to 15
            Set psCaption to "Follow Windows"
            Set piThemeMode to CI_FTThemeSystem
        End_Object

        Object oDialogBtn is a cDemoButton
            Set piRowIndex to 0
            Set piColumnIndex to 44    // the right edge: column 43 before it takes the extra width
            Set piColumnSpan to 18
            Set psCaption to "Open the dialog"
            Set pbBold to True
            // The glyph as a class (ftglyphs.css), with the primary look: a literal class list is what the
            // Studio's Designer draws - it never runs the code that turns psGlyph / pbPrimary into classes.
            Set psCSSClass to "ftbtn ftbtn-primary ftg-info"
            Set pbPrimary to True
            Set psToolTip to "A cFTModalPanel with a Close button of its own"

            Procedure OnButtonClick
                Send Popup of (oDemoDialog(Self))
            End_Procedure
        End_Object

        // Row 1: the page.
        Object oPage is a cFTHtmlPage
            Set piRowIndex to 1
            Set piColumnIndex to 0
            Set piColumnSpan to 62          // all the columns
            Set pbFillHeight to True        // fills row 1, which takes the extra height; it scrolls itself
            Set psTitleIcon to "Images/RDC-Mark.svg"    // the RDC Tools mark, as the package manager shows it
            /* DESIGN-TIME PLACEHOLDER - the Studio's Designer models only a literal psHtml. It is the page's REAL
               header, in the page's own classes (demo.css - application.css imports it for the Designer), with
               Lorem ipsum for the body text: the Designer shows the page's shape, and no copied text can drift
               from the real page. Keep the h1 in step with the title and psTitleIcon. The background is the
               page's own token, so the text reads on whatever the Designer paints behind the host. */
            Set psHtml to '<div class="demo" style="background:var(--dfr-bg-page);min-height:100%"><h1><img class="titleicon" src="Images/RDC-Mark.svg" alt="">RDCFlexTron</h1><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p><h2>On this window</h2><ul><li>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</li><li>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</li><li>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</li></ul><h2>Theme</h2><p>Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium.</p></div>'

            // The runtime page - set here, so the Designer keeps the literal above.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (DemoPageHtml(TitleIconHtml(Self)))
            End_Procedure
        End_Object

        // Row 2: Exit, bottom right - its 10 columns end where the dialog button's 18 do.
        Object oExitBtn is a cDemoButton
            Set piRowIndex to 2
            Set piColumnIndex to 52
            Set psCaption to "Exit"
            Set psCSSClass to "ftbtn ftg-exit"     // the glyph as a class, so the Designer draws it too (ftglyphs.css)
            Set psToolTip to "Close the demo"

            // Runs after the web click has returned, so the program can end here.
            Procedure OnButtonClick
                Send Exit_Application
            End_Procedure
        End_Object

        // The demo's own sheet in the page head, so its grid rules (demo.css) are there from the first paint.
        Procedure OnDefineScriptIncludes String[] ByRef aScriptHtml
            Forward Send OnDefineScriptIncludes (&aScriptHtml)
            Move (CssLink("demo")) to aScriptHtml[SizeOfArray(aScriptHtml)]
        End_Procedure
    End_Object

    // cFTPanel fits the host to the client area, when the window is shown and on every resize.
    Set phoClientHost to (oHost(Self))
End_Object

Start_UI
