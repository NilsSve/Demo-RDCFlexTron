//****************************************************************************
// $Module type: Dialog
// $Module name: DemoWebControls
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-10-10
//
// Description : What the library does to the framework's own web controls, as a before and after: the same
//               controls on an FT host, on the left, and on the framework's own host, on the right - a check
//               box and a radio button in each of their states, a group, and tab pages with one switched off.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use Windows.pkg
Use cFTModalPanel.pkg
Use cLocalWebControlHost.pkg        // the framework's own host - the right-hand column
Use cFTLocalWebControlHost.pkg      // a web control needs a host Used before it
Use cFTGridHost.pkg                 // the FT host as a grid of 8 px columns - the left-hand column, and the bar
Use FTAllWebControlClasses.pkg      // the framework's web classes, and the cFT ones
Use FTMarkupBuilders.pkg            // DivOpen, TagText, BarButtonHtml, IconLabel, CssLink
Use FTDashIcons.pkg                 // the CS_Glyph* names
Use FTMessageBox.dg                 // FTInfoBox

/* A BEFORE AND AFTER (Nils 2026-10-10, RDCFlexTron 0.9.21 to 0.9.23). The two columns hold THE SAME OBJECTS,
   line for line: the framework's own web controls - cWebForm, cWebCombo, cWebDateForm, cWebCheckbox, cWebRadio,
   cWebGroup, cWebEdit, cWebTabContainer, cWebLabel - with the same properties. Not one of them is a cFT class.

   THE STATES (Nils 2026-10-10: "much clearer with the different modes"). A look is more than one picture of a
   control: a check box is ticked or not, and either of them switched off; a radio button the same; a tab is
   open, shut or switched off. So each stands here in each of its states, with a caption that says which - the
   two check boxes and the two radio buttons that can be clicked write their captions anew as they change.

   - On the left their host is a cFTGridHost. An FT host takes the theme, and it marks its page with the class
     FtHost, which the library's ftcontrols.css gives the framework's controls the FT look on: the FT text
     size, the palette's colours, and a label on the left right-justified - not one of these objects names
     an alignment. A check box's box and a radio's ring are the palette's, green when ticked or chosen and
     dim when switched off; a group and the tab pages are FT cards, the open tab marked by the amber line;
     the date picker's panel is painted from the palette, the chosen day in amber. So a control needs no cFT
     class to look right here; a cFT class adds what a control DOES - cFTWebForm its change events,
     cFTWebButton its glyph and its click after the web event - not how it looks.
   - On the right their host is the framework's own cLocalWebControlHost, with nothing of the library's: the
     Web UI theme as it comes. It is given a cFTGridHost's layout - 8 px columns, the same rows - so the columns
     line up row for row and what differs is the look alone: larger text, the theme's colours, labels
     left-justified. It does not follow the Dark / Light choice, so in Dark it is a light block: that is what
     the page is without the library. Both columns are 232 units wide: a date picker's panel cannot leave
     its host's window, and at the theme's own text size it needs that much (Nils 2026-10-10).

   THE BAR at the bottom is a third host, an FT one. Its line says what a control reported: a framework
   control's events reach the program the same on both hosts. A cFTWebCheckbox switches the line on and off,
   and "About this line" is a markup button in a box of its own.

   TWO BOXES, NOT ONE, and on purpose: a control's change in one host must never redraw something the user is
   about to click in another - the click that takes the focus from a field sends the field's change first, the
   redraw replaces the element under the pointer, and the click is lost. So the line that is redrawn
   (oStatusBox, UpdateHtml) holds text only, and the markup button sits in a box that is drawn once
   (oAboutBox). */
Object oDemoWebControls is a cFTModalPanel
    Set Label to "The framework's web controls, with the library and without it"
    Set Location to 10 10
    Set Size to 376 476
    Set piMinSize to 376 476
    // The dialog grows downwards only - the tab pages take the room. Its width is fixed, so the two columns
    // stay the same width: anchors cannot share a width between two controls.
    Set piMaxSize to 2000 476

    // The line says what the controls report while this is True - the bar's check box sets it.
    Property Boolean pbSayChanges True

    // The line's markup: what was said, and nothing to click. Above the objects that call it.
    Function StatusHtml String sText Returns String
        String s
        Move (CS_PaletteCssLink + (CssLink("demo")) + (DivOpen("demostatus"))) to s
        Append s (TagText("span", "said", sText))
        Append s CS_DivEnd
        Function_Return s
    End_Function

    Object oFTHead_tb is a TextBox
        Set Location to 4 6
        Set Size to 9 232
        Set Label to "With the library: on a cFTGridHost"
    End_Object

    Object oPlainHead_tb is a TextBox
        Set Location to 4 242
        Set Size to 9 232
        Set peAnchors to anTopRight
        Set Label to "Without it: on a cLocalWebControlHost"
    End_Object

    /* THE FT HOST: a grid of 8 px columns - 33 of them, of which columns 8 and 24 share the extra width, one
       in each half of the row: the check boxes stand in the left half and the radio buttons in the right, and
       each needs room for its caption (with one stretching column the other half stayed 128 px, and its
       caption folded - Nils 2026-10-10). A control that spans the row is as wide as the host either way. Row
       10, the tab pages, takes the extra height. The objects in it are the framework's own classes; the host
       is all the library there is on this side. */
    Object oFTHost is a cFTGridHost
        Set Location to 16 4
        Set Size to 304 232
        Set peAnchors to anTopBottomLeft
        Set piColumnCount to 33
        Set psColumnWidths to "8/1fr 24/1fr"
        Set psRowHeights to "10/1fr"

        Register_Object oRadioTwo           // oRadioOne's OnSelect names it, and it stands below

        // Row 0: a field of text.
        Object oForm is a cWebForm
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set piLabelOffset to 104
            Set psLabel to "cWebForm:"
            Set psValue to "Some text"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                Send ShowChange ("cWebForm: " + sNewValue)
            End_Procedure
        End_Object

        // Row 1: a choice.
        Object oCombo is a cWebCombo
            Set piRowIndex to 1
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set piLabelOffset to 104
            Set psLabel to "cWebCombo:"
            Set pbAddEmptyItem to False
            Set psValue to "amber"
            Set pbServerOnChange to True

            Procedure OnFill
                Forward Send OnFill
                Send AddComboItem "amber" "Amber"
                Send AddComboItem "mint" "Mint"
                Send AddComboItem "coral" "Coral"
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send ShowChange ("cWebCombo: " + sNewValue)
            End_Procedure
        End_Object

        // Row 2: a date, with its picker.
        Object oDate is a cWebDateForm
            Set piRowIndex to 2
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set piLabelOffset to 104
            Set psLabel to "cWebDateForm:"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                Send ShowChange ("cWebDateForm: " + sNewValue)
            End_Procedure
        End_Object

        /* Rows 3 to 6, the left half: a check box in each of its states - not ticked, ticked, and the two again
           switched off. Each caption says the state: the two that can be clicked write their caption anew when
           they change, so it stays true. */
        Object oTick is a cWebCheckbox
            Set piRowIndex to 3
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Not ticked"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "0"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                WebSet psCaption to (If(GetChecked(Self), "Ticked", "Not ticked"))
                Send ShowChange ("cWebCheckbox, the first: " + If(GetChecked(Self), "ticked", "not ticked"))
            End_Procedure
        End_Object

        Object oTickOn is a cWebCheckbox
            Set piRowIndex to 4
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Ticked"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "1"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                WebSet psCaption to (If(GetChecked(Self), "Ticked", "Not ticked"))
                Send ShowChange ("cWebCheckbox, the second: " + If(GetChecked(Self), "ticked", "not ticked"))
            End_Procedure
        End_Object

        Object oTickDisabled is a cWebCheckbox
            Set piRowIndex to 5
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Switched off"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "0"
            Set pbEnabled to False
        End_Object

        Object oTickDisabledOn is a cWebCheckbox
            Set piRowIndex to 6
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Off, ticked"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "1"
            Set pbEnabled to False
        End_Object

        /* Rows 3 to 6, the right half: radio buttons, two groups of two. The first two can be clicked, and the
           one that is chosen says so; the other two are switched off, one of them chosen. A group is the radio
           buttons of one host that share a psGroupName, and a psValue on one of them - its own psRadioValue -
           chooses it at the start. */
        Object oRadioOne is a cWebRadio
            Set piRowIndex to 3
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "live"
            Set psCaption to "Not chosen"
            Set psRadioValue to "1"
            Set pbServerOnSelect to True

            Procedure OnSelect
                WebSet psCaption to "Chosen"
                WebSet psCaption of (oRadioTwo(Self)) to "Not chosen"
                Send ShowChange "cWebRadio: the first"
            End_Procedure
        End_Object

        Object oRadioTwo is a cWebRadio
            Set piRowIndex to 4
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "live"
            Set psCaption to "Chosen"
            Set psRadioValue to "2"
            Set psValue to "2"
            Set pbServerOnSelect to True

            Procedure OnSelect
                WebSet psCaption to "Chosen"
                WebSet psCaption of (oRadioOne(Self)) to "Not chosen"
                Send ShowChange "cWebRadio: the second"
            End_Procedure
        End_Object

        Object oRadioDisabled is a cWebRadio
            Set piRowIndex to 5
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "off"
            Set psCaption to "Switched off"
            Set psRadioValue to "1"
            Set pbEnabled to False
        End_Object

        Object oRadioDisabledOn is a cWebRadio
            Set piRowIndex to 6
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "off"
            Set psCaption to "Off, chosen"
            Set psRadioValue to "2"
            Set psValue to "2"
            Set pbEnabled to False
        End_Object

        // Rows 7 to 9: a group with its caption, and text of several lines inside it.
        Object oGroup is a cWebGroup
            Set piRowIndex to 7
            Set piRowSpan to 3
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set psCaption to "A cWebGroup"
            Set piColumnCount to 1

            Object oEdit is a cWebEdit
                Set piColumnIndex to 0
                Set piColumnSpan to 1
                Set piLabelOffset to 88
                Set psLabel to "cWebEdit:"
                Set psValue to "Text of several lines."
                Set piHeight to 50
                Set pbServerOnChange to True

                Procedure OnChange String sNewValue String sOldValue
                    Send ShowChange ("cWebEdit, in the group: " + String(Length(sNewValue)) + " characters")
                End_Procedure
            End_Object
        End_Object

        // Row 10: pages - one that is open, one more, and one that is switched off. It takes the extra height.
        Object oTabs is a cWebTabContainer
            Set piRowIndex to 10
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set pbFillHeight to True
            Set piMinHeight to 80
            Set pbServerOnCardChange to True

            Object oFirstPage is a cWebTabPage
                Set psCaption to "A cWebTabPage"
                Set piColumnCount to 1

                Object oLabel is a cWebLabel
                    Set piColumnIndex to 0
                    Set piColumnSpan to 1
                    Set psCaption to "A cWebLabel: a caption of its own"
                End_Object
            End_Object

            Object oSecondPage is a cWebTabPage
                Set psCaption to "Another page"
                Set piColumnCount to 1

                Object oSecondTick is a cWebCheckbox
                    Set piColumnIndex to 0
                    Set piColumnSpan to 1
                    Set psCaption to "A cWebCheckbox on page two"
                End_Object
            End_Object

            Object oThirdPage is a cWebTabPage
                Set psCaption to "Switched off"
                Set pbEnabled to False
                Set piColumnCount to 1
            End_Object

            Procedure OnCardChange String sNewSelectedTab String sPrevSelectedTab
                Forward Send OnCardChange sNewSelectedTab sPrevSelectedTab
                Send ShowChange "cWebTabContainer: another page"
            End_Procedure
        End_Object

        // What a control reported, to the panel's line.
        Procedure ShowChange String sText
            Send Heard of (oDemoWebControls(Self)) ("On the FT host - " + sText)
        End_Procedure
    End_Object

    /* THE FRAMEWORK'S OWN HOST, with a grid host's layout: the three layout properties are what cFTGridHost
       sets, so the rows and columns here are the left-hand ones. Nothing else of the library reaches this
       page: it has no FtHost class, and it takes no theme. (The panel gives the control's own ground its
       colour, as it does every native child; the page inside is the framework's.) */
    Object oPlainHost is a cLocalWebControlHost
        Set Location to 16 240
        Set Size to 304 232
        Set peAnchors to anTopBottomRight
        Set peLayoutType to ltGrid
        Set psDefaultColumnWidth to "8px"
        Set psDefaultRowHeight to "minmax(33px, max-content)"
        Set piColumnCount to 33
        Set psColumnWidths to "8/1fr 24/1fr"
        Set psRowHeights to "10/1fr"

        Register_Object oRadioTwo           // oRadioOne's OnSelect names it, and it stands below

        // Row 0: a field of text.
        Object oForm is a cWebForm
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set piLabelOffset to 104
            Set psLabel to "cWebForm:"
            Set psValue to "Some text"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                Send ShowChange ("cWebForm: " + sNewValue)
            End_Procedure
        End_Object

        // Row 1: a choice.
        Object oCombo is a cWebCombo
            Set piRowIndex to 1
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set piLabelOffset to 104
            Set psLabel to "cWebCombo:"
            Set pbAddEmptyItem to False
            Set psValue to "amber"
            Set pbServerOnChange to True

            Procedure OnFill
                Forward Send OnFill
                Send AddComboItem "amber" "Amber"
                Send AddComboItem "mint" "Mint"
                Send AddComboItem "coral" "Coral"
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send ShowChange ("cWebCombo: " + sNewValue)
            End_Procedure
        End_Object

        // Row 2: a date, with its picker.
        Object oDate is a cWebDateForm
            Set piRowIndex to 2
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set piLabelOffset to 104
            Set psLabel to "cWebDateForm:"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                Send ShowChange ("cWebDateForm: " + sNewValue)
            End_Procedure
        End_Object

        /* Rows 3 to 6, the left half: a check box in each of its states - not ticked, ticked, and the two again
           switched off. Each caption says the state: the two that can be clicked write their caption anew when
           they change, so it stays true. */
        Object oTick is a cWebCheckbox
            Set piRowIndex to 3
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Not ticked"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "0"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                WebSet psCaption to (If(GetChecked(Self), "Ticked", "Not ticked"))
                Send ShowChange ("cWebCheckbox, the first: " + If(GetChecked(Self), "ticked", "not ticked"))
            End_Procedure
        End_Object

        Object oTickOn is a cWebCheckbox
            Set piRowIndex to 4
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Ticked"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "1"
            Set pbServerOnChange to True

            Procedure OnChange String sNewValue String sOldValue
                WebSet psCaption to (If(GetChecked(Self), "Ticked", "Not ticked"))
                Send ShowChange ("cWebCheckbox, the second: " + If(GetChecked(Self), "ticked", "not ticked"))
            End_Procedure
        End_Object

        Object oTickDisabled is a cWebCheckbox
            Set piRowIndex to 5
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Switched off"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "0"
            Set pbEnabled to False
        End_Object

        Object oTickDisabledOn is a cWebCheckbox
            Set piRowIndex to 6
            Set piColumnIndex to 0
            Set piColumnSpan to 16
            Set pbShowLabel to False
            Set psCaption to "Off, ticked"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "1"
            Set pbEnabled to False
        End_Object

        /* Rows 3 to 6, the right half: radio buttons, two groups of two. The first two can be clicked, and the
           one that is chosen says so; the other two are switched off, one of them chosen. A group is the radio
           buttons of one host that share a psGroupName, and a psValue on one of them - its own psRadioValue -
           chooses it at the start. */
        Object oRadioOne is a cWebRadio
            Set piRowIndex to 3
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "live"
            Set psCaption to "Not chosen"
            Set psRadioValue to "1"
            Set pbServerOnSelect to True

            Procedure OnSelect
                WebSet psCaption to "Chosen"
                WebSet psCaption of (oRadioTwo(Self)) to "Not chosen"
                Send ShowChange "cWebRadio: the first"
            End_Procedure
        End_Object

        Object oRadioTwo is a cWebRadio
            Set piRowIndex to 4
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "live"
            Set psCaption to "Chosen"
            Set psRadioValue to "2"
            Set psValue to "2"
            Set pbServerOnSelect to True

            Procedure OnSelect
                WebSet psCaption to "Chosen"
                WebSet psCaption of (oRadioOne(Self)) to "Not chosen"
                Send ShowChange "cWebRadio: the second"
            End_Procedure
        End_Object

        Object oRadioDisabled is a cWebRadio
            Set piRowIndex to 5
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "off"
            Set psCaption to "Switched off"
            Set psRadioValue to "1"
            Set pbEnabled to False
        End_Object

        Object oRadioDisabledOn is a cWebRadio
            Set piRowIndex to 6
            Set piColumnIndex to 16
            Set piColumnSpan to 17
            Set psGroupName to "off"
            Set psCaption to "Off, chosen"
            Set psRadioValue to "2"
            Set psValue to "2"
            Set pbEnabled to False
        End_Object

        // Rows 7 to 9: a group with its caption, and text of several lines inside it.
        Object oGroup is a cWebGroup
            Set piRowIndex to 7
            Set piRowSpan to 3
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set psCaption to "A cWebGroup"
            Set piColumnCount to 1

            Object oEdit is a cWebEdit
                Set piColumnIndex to 0
                Set piColumnSpan to 1
                Set piLabelOffset to 88
                Set psLabel to "cWebEdit:"
                Set psValue to "Text of several lines."
                Set piHeight to 50
                Set pbServerOnChange to True

                Procedure OnChange String sNewValue String sOldValue
                    Send ShowChange ("cWebEdit, in the group: " + String(Length(sNewValue)) + " characters")
                End_Procedure
            End_Object
        End_Object

        // Row 10: pages - one that is open, one more, and one that is switched off. It takes the extra height.
        Object oTabs is a cWebTabContainer
            Set piRowIndex to 10
            Set piColumnIndex to 0
            Set piColumnSpan to 33
            Set pbFillHeight to True
            Set piMinHeight to 80
            Set pbServerOnCardChange to True

            Object oFirstPage is a cWebTabPage
                Set psCaption to "A cWebTabPage"
                Set piColumnCount to 1

                Object oLabel is a cWebLabel
                    Set piColumnIndex to 0
                    Set piColumnSpan to 1
                    Set psCaption to "A cWebLabel: a caption of its own"
                End_Object
            End_Object

            Object oSecondPage is a cWebTabPage
                Set psCaption to "Another page"
                Set piColumnCount to 1

                Object oSecondTick is a cWebCheckbox
                    Set piColumnIndex to 0
                    Set piColumnSpan to 1
                    Set psCaption to "A cWebCheckbox on page two"
                End_Object
            End_Object

            Object oThirdPage is a cWebTabPage
                Set psCaption to "Switched off"
                Set pbEnabled to False
                Set piColumnCount to 1
            End_Object

            Procedure OnCardChange String sNewSelectedTab String sPrevSelectedTab
                Forward Send OnCardChange sNewSelectedTab sPrevSelectedTab
                Send ShowChange "cWebTabContainer: another page"
            End_Procedure
        End_Object

        // What a control reported, to the panel's line.
        Procedure ShowChange String sText
            Send Heard of (oDemoWebControls(Self)) ("On the framework's host - " + sText)
        End_Procedure
    End_Object

    /* THE BAR: an FT grid host across the bottom. Row 0 is the line; row 1 a cFTWebCheckbox at the left, then
       column 28, which takes the extra width, the markup button's box and Close at the right edge. Its height:
       two rows, 66 px, and the 4 px the theme pads a host's content by, above and below - a host shorter than
       its content scrolls. 48 units hold that at 100 % and above. */
    Object oBarHost is a cFTGridHost
        Set Location to 324 4
        Set Size to 48 468
        Set peAnchors to anBottomLeftRight
        Set piColumnCount to 57
        Set psColumnWidths to "28/1fr"

        // The line: text only, redrawn by UpdateHtml whenever a control reports - from another host too.
        Object oStatusBox is a cFTWebHtmlBox
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan to 57
            Set psHtml to '<div class="demostatus"><span class="said">The same controls, line for line - the difference is the library. Change one, and this line says so.</span></div>'

            // The real line, built when the program runs - the Designer shows the literal above.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (StatusHtml(Self, "The same controls, line for line - the difference is the library. Change one, and this line says so."))
            End_Procedure
        End_Object

        // A cFT class at work: the FT look, and Clear ignored. It switches the line on and off.
        Object oSayTick is a cFTWebCheckbox
            Set piRowIndex to 1
            Set piColumnIndex to 0
            Set piColumnSpan to 28
            Set pbShowLabel to False
            Set psCaption to "Say what the controls report"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set psValue to "1"
            Set pbServerOnChange to True
            Set psToolTip to "A cFTWebCheckbox: the line above is written while it is ticked"

            Procedure OnChange String sNewValue String sOldValue
                Boolean bSay
                Get GetChecked to bSay
                Set pbSayChanges of (oDemoWebControls(Self)) to bSay
                Send UpdateHtml of (oStatusBox(Self)) (StatusHtml(Self, If(bSay, "The line is listening again.", "The line is quiet.")))
            End_Procedure
        End_Object

        // A markup button, in a box that is drawn once. Its click reaches OnHtmlClick after the web click has
        // returned, so a message box can open there.
        Object oAboutBox is a cFTWebHtmlBox
            Set piRowIndex to 1
            Set piColumnIndex to 29
            Set piColumnSpan to 18
            Set psHtml to '<div class="demostatus"><div class="rpbtn">About this line</div></div>'

            Procedure End_Construct_Object
                String s
                Forward Send End_Construct_Object
                Move (CS_PaletteCssLink + (CssLink("demo")) + (DivOpen("demostatus right"))) to s
                Append s (BarButtonHtml("rpbtn", "about", "", (IconLabel(CS_GlyphInfo, "About this line")), "What the line is made of", True))
                Append s CS_DivEnd
                Set psHtml to s
            End_Procedure

            Procedure OnHtmlClick String sId String sParam
                If (sId = "about") Begin
                    Send FTInfoBox ("The line is a cFTWebHtmlBox: UpdateHtml gives it new markup while the dialog is up, from another host's event too." + ;
                        "\nThis button is markup, built with BarButtonHtml, in a second box that is drawn once. A click reaches OnHtmlClick after the web click has returned, so this box could open.") "About this line"
                End
            End_Procedure
        End_Object

        Object oCloseBtn is a cFTWebButton
            Set piRowIndex to 1
            Set piColumnIndex to 47
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close this dialog"

            Procedure OnButtonClick
                Send Close_Panel of (oDemoWebControls(Self))
            End_Procedure
        End_Object
    End_Object

    // What a control reported, on the bar's line - unless the check box has switched it off.
    Procedure Heard String sText
        If (pbSayChanges(Self)) ;
            Send UpdateHtml of (oStatusBox(oBarHost(Self))) (StatusHtml(Self, sText))
    End_Procedure

    On_Key Key_Alt+Key_C Send Close_Panel
    On_Key kCancel       Send Close_Panel
End_Object
