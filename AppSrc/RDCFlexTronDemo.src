//****************************************************************************
// $Module type: Program
// $Module name: RDCFlexTronDemo
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-23
//
// Description : The RDCFlexTron library at work in a Windows program: ONE themed FlexTron host laid out
//               as a grid (cFTGridHost) holding a page built with the markup builders and icons,
//               cFTWebButton objects - real web buttons the Studio's Designer draws - a combo, a list and
//               the message boxes; a modal panel with a Close button of its own (DemoDialog.dg); the stand-ins
//               the Studio's Designer draws for content built at run time (DemoStandIns.dg); and the
//               Dark / Light / Follow Windows choice.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use DFAllEnt.pkg
Use FTConstants.h.pkg               // the CI_FTTheme* modes, and where the theme choice is saved
Use cFTApplication.pkg              // the application object: it reads the theme choice, and switches it
Use cFTPanel.pkg                    // the main window: a Panel with the FT ground colour
Use cFTLocalWebControlHost.pkg      // a web control needs a host Used before it
Use cFTGridHost.pkg                 // the host as a grid of 8 px columns, laid out like a Windows dialog
Use FTAllWebControlClasses.pkg      // cFTWebButton, cFTWebLabel, cFTWebHtmlBox and the rest of the family
Use cThemeButton.pkg                // a cFTWebButton for one theme: Dark, Light or Follow Windows
Use cFTHtmlPage.pkg                 // a whole page: its title (psLabel) and the picture beside it (psTitleIcon)
Use FTMarkupBuilders.pkg            // DivOpen, TagHtml, MarkedText, CssLink ...
Use FTDashIcons.pkg                 // DashIcon and its CS_Glyph* names
Use DemoDialog.dg                   // oDemoDialog - the modal panel that "Open the dialog" opens
Use DemoStandIns.dg                 // oDemoStandIns - the Designer's stand-ins, which "Stand-ins" opens
Use FTMessageBox.dg                 // FTInfoBox, FTStopBox, FTYesNoBox: Info_Box and the rest in the FT look

// The application object: a cFTApplication reads the theme choice (Settings\FTTheme under this program's
// registry key) as soon as it is built, and the two dialogs above - built before it - take it there and
// then, before they are shown. Its SwitchTheme - the theme buttons' click - saves a new choice and starts
// the demo again in it.
Object oApplication is a cFTApplication
    Set psCompany to "RDC Tools International"
    Set psProduct to "RDCFlexTron Demo"
    Set psVersion to "26.0"
    Set peHelpType to htNoHelp
End_Object

// ---------------------------------------------------------------------------------------------------
// The pages - global functions, so they are defined before the objects that call them.
// ---------------------------------------------------------------------------------------------------

// The main window's page: the library in a few lines, built with the builders it describes. Its title is the
// page's psLabel, which cFTHtmlPage draws above it. Each text is a """ string: DataFlex drops its first and
// last line break and the common indentation, and the page shows a line break inside it as a space - so a
// text wraps here as a paragraph. A name is marked with backticks, as in a README: MarkedText puts it in
// <code> and escapes the rest, and BulletItem takes the markup it returns.
Function DemoPageHtml Global Returns String
    String s sItems
    Move (CS_PaletteCssLink + (CssLink("demo")) + (DivOpen("demo"))) to s
    Append s (TagText("p", "", """
        Themed FlexTron hosts, web controls and modal panels for DataFlex Windows programs, with HTML
        builders and inline icons.
        """))
    Append s (TagText("h2", "", "On this window"))

    Append sItems (BulletItem(MarkedText("""
        The whole window is ONE host, a `cFTGridHost`: a grid of 8 px columns and five rows - the theme
        buttons with Open the dialog, the glyph combo with Stand-ins, the glyph list with this page, a row of
        air, and the message boxes with Exit. A control takes a row with `piRowIndex`, and this page fills its
        row with `pbFillHeight`.
        """)))
    Append sItems (BulletItem(MarkedText("""
        This page is a `cFTHtmlPage`, built with `FTMarkupBuilders`.
        """)))
    Append sItems (BulletItem(MarkedText("""
        The title above is the page's `psLabel`. The mark beside it is a glyph of the demo's own, an SVG
        file in `AppHtml\FTGlyphs`: rdcmark.svg is the glyph `rdcmark`. When the program starts, it writes
        the folder's classes into a sheet there, so the Studio's Designer shows the mark too, with Lorem
        ipsum for this text.
        """)))
    Append sItems (BulletItem(MarkedText("""
        The buttons above are `cFTWebButton` objects: real web buttons, so the Studio's Designer draws them.
        A glyph is a class in `psCSSClass` - `ftg-exit` and the like, from ftglyphs.css - so the Designer
        draws it too. The font is `psFontFamily`, `piFontSize` and `pbBold`.
        """)))
    Append sItems (BulletItem(MarkedText("""
        The combo is a `cFTWebCombo`, in the FT look (`FtCompact`, from ftcontrols.css), which the Studio's
        Designer draws too. Its `OnChange` sends the glyph to the Preview button's `UpdateGlyph`, which
        changes it while the program runs.
        """)))
    Append sItems (BulletItem(MarkedText("""
        The list on the left is a `cFTWebList` with every glyph there is (`FTGlyphNames`) - the library's,
        and the demo's own `rdcmark`. Its rows come from code (`OnManualLoadData`), and it asks for them
        itself when the page first draws it. Choose a row, and `OnChangeCurrentRow` gives its glyph to the
        Preview button and the combo.
        """)))
    Append sItems (BulletItem(MarkedText("""
        Stand-ins opens the shapes the library's ftcontrols.css draws for the Studio's Designer. The Designer
        runs no code, so a page whose content is built when the program runs shows nothing there; one short
        literal `psHtml` draws the shape instead - a grid, a list, a tree, a log, a chart or cards - and the
        program sets the real content before the page is shown.
        """)))
    Append sItems (BulletItem(MarkedText("""
        Each column is 8 px, so a button's span is its width in 8 px steps: a `cFTWebButton` takes 10 unless
        it says otherwise - Follow Windows takes 15, Open the dialog 18. One column takes the extra width -
        empty in the rows of buttons, part of this page in its own - and this page's row the extra height,
        so the buttons keep their size and the right-hand ones stay at the edge - like anchors in a Windows
        dialog.
        """)))
    Append sItems (BulletItem(MarkedText("""
        A click's work is the button's `OnButtonClick`, which runs after the web click has returned - so it
        can open a dialog, or restart the program.
        """)))
    Append sItems (BulletItem(MarkedText("""
        The three buttons at the bottom left show `FTInfoBox`, `FTStopBox` and `FTYesNoBox`: `Info_Box`,
        `Stop_Box` and `YesNo_Box` in the FT look, with the same arguments and return values.
        """)))
    Append s (BulletList(sItems))

    Append s (TagText("h2", "", "Theme"))
    Append s (TagText("p", "", ("In use: " + (FTThemeName(giFTThemeMode)) + ;
        ". A new choice is saved, and the demo restarts in it.")))
    Append s CS_DivEnd
    Function_Return s
End_Function

// ---------------------------------------------------------------------------------------------------
// The main window
// ---------------------------------------------------------------------------------------------------

/* The main window: ONE host, laid out like a Windows dialog on a grid of 8 px columns and five rows - the
   theme buttons and the glyph combo at the top, the glyph list and the page in the middle taking the extra
   height, a row of air, and the message boxes with Exit at the bottom. The grid does the layout, in the
   browser, on every resize; cFTPanel fits the host itself to the window's client area (phoClientHost). */
Object oMain is a cFTPanel
    Set Label to "RDCFlexTron Demo"
    Set Location to 190 119
    Set Size to 300 450
    Set piMinSize to 180 360  

    /* THE HOST: every control of the window, on one grid (cFTGridHost). Each is an object of its own,
       so the Studio's Designer draws it where it sits. */
    Object oHost is a cFTGridHost
        Set Location to 4 4
        Set Size to 275 432
        Set peAnchors to anNone             // placed by cFTPanel (phoClientHost)
        // 62 columns: 61 of 8 px (488 px) and column 43, which takes the extra width. The window's minimum
        // width (360 units, about 516 px for the host at 1.5 px a unit) still holds them.
        Set piColumnCount to 62
        Set psColumnWidths to "43/1fr"      // column 43 - empty - takes the extra width
        Set psRowHeights to "2/1fr 3/8px"   // row 2, the list and the page, takes the extra height; row 3 is 8 px of air

        // Row 0: the theme choice on the left, the dialog button at the right edge.
        Object oThemeLabel is a cFTWebLabel
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan to 8
            Set psCaption to "Theme"
            Set psCSSClass to "FtCompact ftaccent"      // ftaccent: the amber caption (ftcontrols.css)
        End_Object

        Object oDarkBtn is a cThemeButton
            Set piRowIndex to 0
            Set piColumnIndex to 8
            Set psCaption to "Dark"
            Set piThemeMode to CI_FTThemeDark
        End_Object

        Object oLightBtn is a cThemeButton
            Set piRowIndex to 0
            Set piColumnIndex to 18
            Set psCaption to "Light"
            Set piThemeMode to CI_FTThemeLight
        End_Object

        Object oSystemBtn is a cThemeButton
            Set piRowIndex to 0
            Set piColumnIndex to 28
            Set piColumnSpan to 15
            Set psCaption to "Follow Windows"
            Set piThemeMode to CI_FTThemeSystem
        End_Object

        Object oDialogBtn is a cFTWebButton
            Set piRowIndex to 0
            Set piColumnIndex to 44    // the right edge: column 43 before it takes the extra width
            Set piColumnSpan to 18
            Set psCaption to "Open the dialog"
            Set pbBold to True
            // The glyph as a class (ftglyphs.css), with the primary look: a literal class list is what the
            // Studio's Designer draws - it never runs the code that turns psGlyph / pbPrimary into classes.
            Set psCSSClass to "ftbtn ftbtn-primary ftg-info"
            Set pbPrimary to True
            Set psToolTip to "A cFTModalPanel with a Close button of its own"

            Procedure OnButtonClick
                Send Popup of (oDemoDialog(Self))
            End_Procedure
        End_Object

        // Row 1: a glyph to try. Its 43 columns (8 + 20 + 15) end where the theme row's do. The Preview button
        // comes before the combo in the source because the combo sends to it - an object is known only below
        // its definition; the grid still places each by its piColumnIndex.
        Object oGlyphLabel is a cFTWebLabel
            Set piRowIndex to 1
            Set piColumnIndex to 0
            Set piColumnSpan to 8
            Set psCaption to "Glyph"
            Set psCSSClass to "FtCompact ftaccent"
        End_Object

        Object oPreviewBtn is a cFTWebButton
            Set piRowIndex to 1
            Set piColumnIndex to 28
            Set piColumnSpan to 15
            Set psCaption to "Preview"
            Set psCSSClass to "ftbtn ftg-home"     // the combo's first glyph; the combo's OnChange sends UpdateGlyph
            Set psToolTip to "The glyph chosen in the combo"
        End_Object

        Object oGlyphCombo is a cFTWebCombo
            Set piRowIndex to 1
            Set piColumnIndex to 8          // 20 columns wide - cFTWebCombo's own width
            Set pbShowLabel to False        // the "Glyph" label on its left names it
            Set pbAddEmptyItem to False     // no empty first item: a glyph is always chosen
            Set psValue to CS_GlyphHome
            Set psToolTip to "A DashIcon glyph - the Preview button shows it"

            // Every glyph - the library's, and the demo's own (FTGlyphNames); an item's value is the glyph's name.
            Procedure OnFill
                String[] asGlyphs
                Integer i
                Forward Send OnFill
                Move (FTGlyphNames()) to asGlyphs
                For i from 0 to (SizeOfArray(asGlyphs) - 1)
                    Send AddComboItem asGlyphs[i] asGlyphs[i]
                Loop
            End_Procedure

            // A choice goes to the Preview button, while the program runs.
            Procedure OnChange String sNewValue String sOldValue
                Send UpdateGlyph of (oPreviewBtn(Self)) sNewValue
            End_Procedure
        End_Object

        // Row 1, at the right edge under the dialog button, as wide as it: the Designer's stand-ins.
        Object oStandInsBtn is a cFTWebButton
            Set piRowIndex to 1
            Set piColumnIndex to 44
            Set piColumnSpan to 18
            Set psCaption to "Stand-ins"
            Set psCSSClass to "ftbtn ftg-eye"
            Set psToolTip to "The shapes the Studio's Designer draws for a page built when the program runs"

            Procedure OnButtonClick
                Send Popup of (oDemoStandIns(Self))
            End_Procedure
        End_Object

        // Row 2: the glyph list on the left - its 43 columns end where the rows above end their left groups -
        // and the page on the right. Both fill the row, which takes the extra height.
        Object oGlyphList is a cFTWebList
            Set piRowIndex to 2
            Set piColumnIndex to 0
            Set piColumnSpan to 43
            Set pbFillHeight to True
            Set pbDataAware to False        // the rows come from OnManualLoadData

            Object oGlyphCol is a cWebColumn
                Set piWidth to 36
                Set pbFixedWidth to True        // 36 px
                Set pbAllowHtml to True         // the cell holds the glyph itself: DashIcon's inline svg
                Set pbValueAsTooltip to False   // not the svg's markup as a tooltip
                Set pbSortable to False
            End_Object

            Object oNameCol is a cWebColumn
                Set psCaption to "Name"
                Set piWidth to 110
                Set pbFixedWidth to True        // 110 px
            End_Object

            Object oClassCol is a cWebColumn
                Set psCaption to "Class"
                Set piWidth to 1                // the rest of the list's width
            End_Object

            // One row per glyph: the glyph, its name and its class - what a cFTWebButton's psCSSClass takes to show
            // it (ftglyphs.css). A row's id is the glyph's name.
            Procedure OnManualLoadData tWebRow[] ByRef aTheRows String ByRef sCurrentRowID tWebGroupConfig[] ByRef aTheGroups tWebGroupHeader[] ByRef aTheGroupHeaders
                String[] asGlyphs
                String sName
                Integer i
                Move (FTGlyphNames()) to asGlyphs
                For i from 0 to (SizeOfArray(asGlyphs) - 1)
                    Move asGlyphs[i] to sName
                    Move sName to aTheRows[i].sRowId
                    Move (DashIcon(sName)) to aTheRows[i].aCells[0].sValue
                    Move sName to aTheRows[i].aCells[1].sValue
                    Move ("ftg-" + sName) to aTheRows[i].aCells[2].sValue
                Loop
                If (sCurrentRowID = "") ;
                    Move CS_GlyphHome to sCurrentRowID      // the glyph the combo and the Preview button start with
            End_Procedure

            // A row chosen: its glyph on the Preview button, and in the combo.
            Procedure OnChangeCurrentRow String sFromRowID String sToRowID
                Forward Send OnChangeCurrentRow sFromRowID sToRowID
                If (sToRowID <> "") Begin
                    Send UpdateGlyph of (oPreviewBtn(Self)) sToRowID
                    WebSet psValue of (oGlyphCombo(Self)) to sToRowID
                End
            End_Procedure
        End_Object

        Object oPage is a cFTHtmlPage
            Set piRowIndex to 2
            Set piColumnIndex to 43
            Set piColumnSpan to 19          // column 43, which takes the extra width, and the 18 after it
            Set pbFillHeight to True        // fills row 2, which takes the extra height; it scrolls itself
            Set psLabel to "RDCFlexTron"    // the page's title - the Studio's Designer shows it too
            // The picture beside it, the RDC Tools mark: the demo's own glyph rdcmark (AppHtml\FTGlyphs\rdcmark.svg).
            // Named by its class, not by psTitleIcon "rdcmark": the Designer runs no code and shows only a class.
            Set psCSSClass to "ftpage ftg-rdcmark"

            // The page, built when the program runs - the Designer shows cFTHtmlPage's Lorem ipsum instead.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (DemoPageHtml())
            End_Procedure
        End_Object

        // Row 3 is empty: 8 px of air (psRowHeights), so Exit does not sit right under the page.
        // Row 4: the message boxes on the left - FTMessageBox.dg's three - and Exit at the bottom right.
        Object oInfoBoxBtn is a cFTWebButton
            Set piRowIndex to 4
            Set piColumnIndex to 0
            Set piColumnSpan to 14
            Set psCaption to "Information"
            Set psCSSClass to "ftbtn ftg-info"
            Set psToolTip to "FTInfoBox - Info_Box in the FT look"

            Procedure OnButtonClick
                String sMessage
                Move "FTInfoBox takes the arguments Info_Box takes, and shows the message in the FT look." to sMessage
                Move (sMessage + "\nIts caption is the page's title, beside the glyph of its kind.") to sMessage
                Send FTInfoBox sMessage "Information"
            End_Procedure
        End_Object

        Object oStopBoxBtn is a cFTWebButton
            Set piRowIndex to 4
            Set piColumnIndex to 14
            Set psCaption to "Stop"
            Set psCSSClass to "ftbtn ftg-stop"
            Set psToolTip to "FTStopBox - Stop_Box in the FT look"

            Procedure OnButtonClick
                Send FTStopBox "FTStopBox is Stop_Box's twin: the same arguments, and a stop mark beside the caption." "Stop"
            End_Procedure
        End_Object

        Object oQuestionBoxBtn is a cFTWebButton
            Set piRowIndex to 4
            Set piColumnIndex to 24
            Set piColumnSpan to 12
            Set psCaption to "Question"
            Set psCSSClass to "ftbtn ftg-help"
            Set psToolTip to "FTYesNoBox - YesNo_Box in the FT look"

            // The answer goes to a second box straight away - the chain FTMessageBox.dg lets settle.
            Procedure OnButtonClick
                Integer iAnswer
                Get FTYesNoBox "Do you like the message boxes in the FT look?" "A question" to iAnswer
                If (iAnswer = MBR_Yes) ;
                    Send FTInfoBox "You answered Yes: FTYesNoBox returned MBR_Yes, as YesNo_Box would." "Your answer"
                Else ;
                    Send FTInfoBox "You answered No: FTYesNoBox returned MBR_No, as YesNo_Box would." "Your answer"
            End_Procedure
        End_Object

        // Exit: its 10 columns end where the dialog button's 18 do.
        Object oExitBtn is a cFTWebButton
            Set piRowIndex to 4
            Set piColumnIndex to 52
            Set psCaption to "Exit"
            Set psCSSClass to "ftbtn ftg-exit"     // the glyph as a class, so the Designer draws it too (ftglyphs.css)
            Set psToolTip to "Close the demo"

            // Runs after the web click has returned, so the program can end here.
            Procedure OnButtonClick
                Send Exit_Application
            End_Procedure
        End_Object

        // The demo's own sheet in the page head, so its grid rules (demo.css) are there from the first paint.
        Procedure OnDefineScriptIncludes String[] ByRef aScriptHtml
            Forward Send OnDefineScriptIncludes (&aScriptHtml)
            Move (CssLink("demo")) to aScriptHtml[-1]
        End_Procedure
    End_Object

    // cFTPanel fits the host to the client area, when the window is shown and on every resize.
    Set phoClientHost to (oHost(Self))
End_Object

Start_UI
