//****************************************************************************
// $Module type: Dialog
// $Module name: DemoDialog
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-24
//
// Description : The demo's modal panel: a cFTModalPanel with ONE grid host - the page, and the Close
//               button under it at the right - which the panel fits to itself (phoClientHost).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cFTModalPanel.pkg
Use cFTLocalWebControlHost.pkg      // a web control needs a host Used before it
Use cFTGridHost.pkg                 // the host as a grid of 8 px columns, laid out like a Windows dialog
Use FTAllWebControlClasses.pkg      // cFTWebButton, cFTWebHtmlBox
Use cFTHtmlPage.pkg                 // a whole page: its title (psLabel) and the picture beside it (psTitleIcon)
Use FTMarkupBuilders.pkg            // DivOpen, TagHtml, MarkedText, CssLink
Use FTDashIcons.pkg                 // DashIcon and its CS_Glyph* names

Object oDemoDialog is a cFTModalPanel
    Set Label to "A cFTModalPanel"
    Set Location to 20 20
    Set Size to 136 340
    Set piMinSize to 136 340

    /* THE HOST: the page, and the Close button under it at the right - one grid host, laid out like the
       main window. Row 0, the page, takes the extra height; row 1 is 8 px of air; column 0, empty in
       row 2, takes the extra width, so Close keeps its size at the bottom right. */
    Object oDlgHost is a cFTGridHost
        Set Location to 4 4
        Set Size to 132 332
        Set peAnchors to anNone             // placed by cFTModalPanel (phoClientHost)
        Set piColumnCount to 11             // column 0, then the Close button's 10
        Set psColumnWidths to "0/1fr"       // column 0 takes the extra width
        Set psRowHeights to "0/1fr 1/8px"   // row 0, the page, takes the extra height; row 1 is 8 px of air

        // Above the html box that calls it: a function must be defined before the call. The page's title is
        // its psLabel, which cFTHtmlPage draws above it.
        Function BodyPage Returns String
            String s
            Move (CS_PaletteCssLink + (CssLink("demo")) + (DivOpen("demo"))) to s
            Append s (TagHtml("p", "", MarkedText("""
                One host, laid out as a grid: this page in a row that takes the extra height, a row of air,
                and the Close button in the row below that, after an empty column that takes the extra
                width. The panel fits the host to itself on every show and every resize (`phoClientHost`).
                """)))
            Append s (TagHtml("p", "", MarkedText("""
                Close is a `cFTWebButton`: its `OnButtonClick` runs after the web click has returned, so it
                can end the panel.
                """)))
            Append s CS_DivEnd
            Function_Return s
        End_Function

        // Row 0: the page, across all the columns.
        Object oDlgBody is a cFTHtmlPage
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan to 11
            Set pbFillHeight to True        // fills row 0, which takes the extra height; it scrolls itself
            Set psLabel to "A cFTModalPanel"            // the page's title - the Studio's Designer shows it too
            Set psCSSClass to "ftpage ftg-listcheck"    // its glyph as a class, so the Designer draws it too

            // The page, built when the program runs - the Designer shows cFTHtmlPage's Lorem ipsum instead.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (BodyPage(Self))
            End_Procedure
        End_Object

        // Row 1 is empty: 8 px of air (psRowHeights), so Close does not sit right under the page.
        // Row 2: Close, bottom right.
        Object oCloseBtn is a cFTWebButton
            Set piRowIndex to 2
            Set piColumnIndex to 1
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"    // the glyph as a class, so the Designer draws it too (ftglyphs.css)
            Set psToolTip to "Close this dialog"

            // Runs after the web click has returned - ending a panel inside it would fault (4410).
            Procedure OnButtonClick
                Send Close_Panel of (oDemoDialog(Self))
            End_Procedure
        End_Object
    End_Object

    // cFTModalPanel fits the host to the panel, when it is shown and on every resize.
    Set phoClientHost to (oDlgHost(Self))
End_Object
